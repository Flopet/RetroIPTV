# RetroIPTV settings template.
#
#   cp .env.example .env
#
# Values here OVERRIDE config.json. .env is git-ignored — keep private URLs
# (e.g. a Tailscale ErsatzTV server) here, not in config.json. Anything left
# unset falls back to config.json, then to the bundled public sample streams.

# Playlist: a local .m3u path (relative to the project root) or an HTTP(S) URL,
# e.g. an ErsatzTV channels endpoint: http://SERVER:8409/iptv/channels.m3u
RETROTV_M3U=assets/sample/channels.m3u

# XMLTV guide: a local path or URL, e.g. http://SERVER:8409/iptv/xmltv.xml
RETROTV_XMLTV=assets/sample/epg.xml

# Channel to power on to (matched against the playlist's channel numbers).
RETROTV_START_CHANNEL=1

# Startup volume. Accepts 0-1 (e.g. 0.8) or 0-100 (e.g. 80).
RETROTV_DEFAULT_VOLUME=0.8
